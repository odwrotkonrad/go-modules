#[what] the che-packages release che vendors and embeds, and the project that publishes it.
#[why] its own file, read by ci/vendor-packages-defs.zsh and depended on by che/Makefile, so the
#   version is declared once rather than repeated at each use. control raises it when the catalog
#   publishes, and the bump proves itself against che's tests before it is adopted.
CHE_PACKAGES_PROJECT=konradodwrot%2Fche-packages
CHE_PACKAGES_VERSION=0.0.8
##[<] 🤖🤖
